      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "sum by (operation, status) (rate(internal_client_total{app=~\".*-production\"}[$__rate_interval]))",
          "legendFormat": "{{operation}} {{status}}",
          "refId": "A"
        }
      ]
    },
