      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "fly_instance_memory_mem_total{app=~\".*-production\"} - fly_instance_memory_mem_available{app=~\".*-production\"}",
          "legendFormat": "{{app}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Internal client (proxy -> retrieval/encoding)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
