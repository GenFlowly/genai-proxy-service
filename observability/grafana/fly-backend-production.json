          "expr": "sum by (vendor) (rate(llm_request_total{app=~\".*-production\",status=\"error\"}[$__rate_interval])) / sum by (vendor) (rate(llm_request_total{app=~\".*-production\"}[$__rate_interval]))",
          "legendFormat": "{{vendor}}",
          "refId": "A"
        }
