[
  {
    "uid": "ret-mem-headroom-prod",
    "title": "Retrieval-server memory headroom < 15%",
    "ruleGroup": "genflowly-production",
    "folderUID": "genflowly-production",
    "orgID": 1,
    "condition": "C",
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "datasourceUid": "__PROM_DS_UID__",
        "model": {
          "refId": "A",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "expr": "fly_instance_memory_mem_available{app=\"genai-retrieval-server-production\"} / fly_instance_memory_mem_total{app=\"genai-retrieval-server-production\"} < 0.15"
        }
      },
      {
        "refId": "B",
        "relativeTimeRange": { "from": 0, "to": 0 },
        "datasourceUid": "__expr__",
        "model": { "refId": "B", "type": "reduce", "expression": "A", "reducer": "last" }
      },
      {
        "refId": "C",
        "relativeTimeRange": { "from": 0, "to": 0 },
        "datasourceUid": "__expr__",
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "B",
          "conditions": [
            { "evaluator": { "params": [-1e308], "type": "gt" }, "operator": { "type": "and" }, "query": { "params": ["C"] }, "reducer": { "type": "last", "params": [] }, "type": "query" }
          ]
        }
      }
    ],
    "noDataState": "OK",
    "execErrState": "Error",
    "for": "30m",
    "annotations": {
      "summary": "retrieval-server VM has had <15% memory available for 30m — on the current leak profile that is hours from an OOM kill. Check process_resident_memory_bytes slope; incident runbook: documents/Incidents/RetrievalServerMemoryLeakIncidentOct2026.md §11."
    },
    "labels": { "severity": "warning", "service": "retrieval-server" }
  },
  {
