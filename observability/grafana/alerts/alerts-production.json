    "labels": { "severity": "warning", "service": "retrieval-server" }
  },
  {
    "uid": "ret-rss-slope-prod",
    "title": "Retrieval-server RSS growing >20 MB/h for 6h",
    "ruleGroup": "genflowly-production",
    "folderUID": "genflowly-production",
    "orgID": 1,
    "condition": "C",
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "datasourceUid": "__PROM_DS_UID__",
        "model": {
          "refId": "A",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "expr": "deriv(process_resident_memory_bytes{app=\"genai-retrieval-server-production\"}[3h]) > 5825"
        }
      },
      {
        "refId": "B",
        "relativeTimeRange": { "from": 0, "to": 0 },
        "datasourceUid": "__expr__",
        "model": { "refId": "B", "type": "reduce", "expression": "A", "reducer": "last" }
      },
      {
        "refId": "C",
        "relativeTimeRange": { "from": 0, "to": 0 },
        "datasourceUid": "__expr__",
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "B",
          "conditions": [
            { "evaluator": { "params": [-1e308], "type": "gt" }, "operator": { "type": "and" }, "query": { "params": ["C"] }, "reducer": { "type": "last", "params": [] }, "type": "query" }
          ]
        }
      }
    ],
    "noDataState": "OK",
    "execErrState": "Error",
    "for": "6h",
    "annotations": {
      "summary": "Slow-leak catcher: RSS has grown >20 MB/h (3h derivative, threshold 5825 B/s) for 6 hours straight on retrieval-server prod. The healthy baseline is <6 MB/h. File a ticket before it becomes an OOM pager."
    },
    "labels": { "severity": "warning", "service": "retrieval-server" }
  },
  {
    "uid": "proxy-gen-transport-prod",
    "title": "Generations dying mid-stream (transport_error)",
    "ruleGroup": "genflowly-production",
    "folderUID": "genflowly-production",
    "orgID": 1,
    "condition": "C",
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "datasourceUid": "__PROM_DS_UID__",
        "model": {
          "refId": "A",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "expr": "sum(rate(generation_total{app=\"genai-proxy-server-production\",status=\"transport_error\"}[10m])) > 0"
        }
      },
      {
        "refId": "B",
        "relativeTimeRange": { "from": 0, "to": 0 },
        "datasourceUid": "__expr__",
        "model": { "refId": "B", "type": "reduce", "expression": "A", "reducer": "last" }
      },
      {
        "refId": "C",
        "relativeTimeRange": { "from": 0, "to": 0 },
        "datasourceUid": "__expr__",
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "B",
          "conditions": [
            { "evaluator": { "params": [-1e308], "type": "gt" }, "operator": { "type": "and" }, "query": { "params": ["C"] }, "reducer": { "type": "last", "params": [] }, "type": "query" }
          ]
        }
      }
    ],
    "noDataState": "OK",
    "execErrState": "Error",
    "for": "10m",
    "annotations": {
      "summary": "Generations are failing mid-stream with transport_error — the retrieval server is dying under them (the Oct 2026 OOM incident's exact signature). These failures NEVER appear as HTTP 5xx because the response already streamed as 200. Check retrieval-server for OOM kills first."
    },
    "labels": { "severity": "critical", "service": "genai-proxy-server" }
  },
