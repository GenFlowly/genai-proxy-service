{
  "uid": "llm-metrics-production",
  "title": "LLM Metrics (Production)",
  "tags": [
    "genflowly",
    "observability",
    "production"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROM",
        "label": "Prometheus datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "vendor",
        "label": "Vendor",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROM}"
        },
        "query": {
          "query": "label_values(llm_request_total{app=~\".*-production\"}, vendor)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROM}"
        },
        "query": {
          "query": "label_values(llm_request_total{app=~\".*-production\", vendor=~\"$vendor\"}, model)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "piechart",
      "title": "Vendor usage distribution",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "pieType": "pie",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "sum by (vendor) (increase(llm_request_total{app=~\".*-production\"}[$__range]))",
          "legendFormat": "{{vendor}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "description": "Share of LLM calls per vendor over the dashboard time range."
    },
    {
      "type": "piechart",
      "title": "Vendor-model usage distribution",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "pieType": "pie",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "sum by (vendor, model) (increase(llm_request_total{app=~\".*-production\"}[$__range]))",
          "legendFormat": "{{vendor}} {{model}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "description": "Share of LLM calls per vendor and model over the dashboard time range."
    },
    {
      "type": "row",
      "title": "Cost",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Total cost per vendor (USD)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "sum by (vendor) (increase(llm_cost_usd_total{app=~\".*-production\"}[$__range]))",
          "legendFormat": "{{vendor}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "description": "Total LLM spend per vendor over the dashboard time range."
    },
    {
      "type": "stat",
      "title": "Total cost per vendor-model (USD)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "sum by (vendor, model) (increase(llm_cost_usd_total{app=~\".*-production\"}[$__range]))",
          "legendFormat": "{{vendor}} {{model}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "description": "Total LLM spend per vendor and model over the dashboard time range."
    },
    {
      "type": "row",
      "title": "Vendor: $vendor",
      "collapsed": true,
      "repeat": "vendor",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "type": "timeseries",
          "title": "Calls \u2014 $model",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "gridPos": {
            "x": 0,
            "y": 19,
            "w": 12,
            "h": 8
          },
          "fieldConfig": {
            "defaults": {
              "custom": {
                "drawStyle": "line",
                "lineWidth": 1,
                "pointSize": 5,
                "showPoints": "always"
              }
            },
            "overrides": [
              {
                "__schemeRef": "status-color-scheme",
                "matcher": {
                  "id": "byRegexp",
                  "options": "/\\b(ok|success|succeeded|2\\d{2}|2xx)\\b/i"
                },
                "properties": [
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "green"
                    }
                  }
                ]
              },
              {
                "__schemeRef": "status-color-scheme",
                "matcher": {
                  "id": "byRegexp",
                  "options": "/\\b(retry|retries|throttle|throttles|fallback|skipped|debounced|disabled|empty|noop|stale|unpriced|zero-token|too_short|not_configured)\\b/i"
                },
                "properties": [
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "yellow"
                    }
                  }
                ]
              },
              {
                "__schemeRef": "status-color-scheme",
                "matcher": {
                  "id": "byRegexp",
                  "options": "/(\\b(error|errors|fail|failed|failure|failures|4\\d{2}|5\\d{2}|4xx|5xx|exhausted|dlq|writeback|timeout)\\b|timed out|validation_error|connect_failed|missing_key)/i"
                },
                "properties": [
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "red"
                    }
                  }
                ]
              }
            ]
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi"
            }
          },
          "targets": [
            {
              "expr": "sum by (model) (increase(llm_request_total{app=~\".*-production\", vendor=~\"$vendor\", model=~\"$model\"}[$__rate_interval]))",
              "legendFormat": "{{model}}",
              "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROM}"
              },
              "refId": "A"
            }
          ],
          "description": "LLM calls per interval.",
          "repeat": "model",
          "repeatDirection": "h",
          "maxPerRow": 2
        },
        {
          "type": "timeseries",
          "title": "Response latency p95 \u2014 $model",
