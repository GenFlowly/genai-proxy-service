                "properties": [
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "yellow"
                    }
                  }
                ]
              },
              {
                "__schemeRef": "status-color-scheme",
                "matcher": {
                  "id": "byRegexp",
                  "options": "/(\\b(error|errors|fail|failed|failure|failures|4\\d{2}|5\\d{2}|4xx|5xx|exhausted|dlq|writeback|timeout)\\b|timed out|validation_error|connect_failed|missing_key)/i"
                },
                "properties": [
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "red"
                    }
                  }
                ]
              }
            ]
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi"
            }
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.95, sum by (le, model) (rate(llm_request_duration_seconds_bucket{app=~\".*-production\", vendor=~\"$vendor\", model=~\"$model\"}[$__rate_interval])))",
              "legendFormat": "{{model}}",
              "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROM}"
              },
              "refId": "A"
            }
          ],
          "description": "p95 time to get a response from the vendor.",
          "repeat": "model",
          "repeatDirection": "h",
          "maxPerRow": 2
        },
