# Local dev environment for the retrieval-server. Copy to .env.local (gitignored)
# and fill in real values. See development.md ("Durable agentic runs").

# Supabase Postgres for durable agent runs (DBOS + LangGraph checkpointer).
# Use the SESSION-POOLER connection string (port 5432, sslmode=require) — NOT the
# transaction pooler (6543). Leave unset to run without durable /runs (the server
# starts normally and the durable path stays inactive).
#   Supabase dashboard -> Connect -> Session pooler.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
