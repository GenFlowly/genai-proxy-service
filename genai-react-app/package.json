{
  "name": "genai-react-app",
  "version": "0.1.0",
  "private": true,
  "proxy": "http://127.0.0.1:8080",
  "dependencies": {
    "@auth0/auth0-react": "^2.11.0",
    "@genflowly/component-library": "^0.1.92",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.548.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.3",
    "react-router": "^6.30.3",
    "react-router-dom": "^6.30.6",
    "react-scripts": "5.0.1",
    "sass": "^1.93.2",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test:watch": "react-scripts test --setupFilesAfterEnv '<rootDir>/src/test/setupTests.ts'",
    "test": "react-scripts test --watchAll=false --setupFilesAfterEnv '<rootDir>/src/test/setupTests.ts'",
    "test:coverage": "react-scripts test --coverage --watchAll=false --setupFilesAfterEnv '<rootDir>/src/test/setupTests.ts'",
    "test:diff": "node scripts/check-coverage.js",
    "eject": "react-scripts eject",
    "prepare": "husky"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/*.models.ts",
      "!src/**/*Core.tsx",
      "!src/test/**/*",
      "!src/reportWebVitals.ts",
      "!src/index.tsx"
    ],
    "coverageReporters": [
      "text",
      "json-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 50,
        "lines": 50,
        "statements": 50
      }
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "husky": "^9.1.7"
  }
}
