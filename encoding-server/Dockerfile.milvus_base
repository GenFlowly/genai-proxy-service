# Build stage
FROM public.ecr.aws/lambda/python:3.12 AS builder

# Install from the exact-pin lock (scripts/compile-python-locks.sh); the lock
# is flat, so the base requirements file is no longer copied.
COPY requirements-store-embeddings.lock.txt /tmp/
RUN pip install --only-binary=:all: --no-cache-dir -r /tmp/requirements-store-embeddings.lock.txt --target /tmp/python

# Runtime stage
FROM public.ecr.aws/lambda/python:3.12

# Copy installed dependencies to Lambda task directory
COPY --from=builder /tmp/python ${LAMBDA_TASK_ROOT}
