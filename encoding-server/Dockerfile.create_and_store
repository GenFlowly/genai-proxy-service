# Build stage
FROM public.ecr.aws/lambda/python:3.11 AS builder

# Install build dependencies
RUN yum install -y gcc gcc-c++ make cmake

# Install from the exact-pin lock (scripts/compile-python-locks.sh); the lock
# is flat, so the base requirements file is no longer copied.
COPY requirements-create-and-store.lock.txt /tmp/
RUN pip install --only-binary=:all: --no-cache-dir -r /tmp/requirements-create-and-store.lock.txt --target /tmp/python

# Runtime stage
FROM public.ecr.aws/lambda/python:3.11

# Redirect HuggingFace cache to /tmp (the only writable dir in Lambda)
ENV HF_HOME=/tmp/hf_cache
ENV TRANSFORMERS_CACHE=/tmp/hf_cache
ENV SENTENCE_TRANSFORMERS_HOME=/tmp/hf_cache

# Copy installed dependencies (including baked-in model) to Lambda task directory
COPY --from=builder /tmp/python ${LAMBDA_TASK_ROOT}

# Copy application code
COPY handlers/create_and_store_lambda.py ${LAMBDA_TASK_ROOT}/handlers/create_and_store_lambda.py
COPY handlers/vector_sync_pending.py ${LAMBDA_TASK_ROOT}/handlers/vector_sync_pending.py
COPY services/content_logging.py ${LAMBDA_TASK_ROOT}/services/content_logging.py
COPY services/content_source.py ${LAMBDA_TASK_ROOT}/services/content_source.py

# Set the handler
CMD [ "handlers.create_and_store_lambda.handler" ]
