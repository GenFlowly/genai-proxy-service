# Build stage
FROM public.ecr.aws/lambda/python:3.11 AS builder

# Install build dependencies
RUN yum install -y gcc gcc-c++ make cmake

# Copy and install dependencies
COPY requirements.txt /tmp/
COPY requirements-parse-and-chunk.txt /tmp/
RUN pip install --only-binary=:all: --no-cache-dir -r /tmp/requirements-parse-and-chunk.txt --target /tmp/python

# Runtime stage
FROM public.ecr.aws/lambda/python:3.11

# Redirect HuggingFace cache to /tmp (the only writable dir in Lambda)
ENV HF_HOME=/tmp/hf_cache
ENV TRANSFORMERS_CACHE=/tmp/hf_cache
ENV SENTENCE_TRANSFORMERS_HOME=/tmp/hf_cache

# Copy installed dependencies (including baked-in model) to Lambda task directory
COPY --from=builder /tmp/python ${LAMBDA_TASK_ROOT}

# Copy application code
COPY handlers ${LAMBDA_TASK_ROOT}/handlers

# Set the handler
CMD [ "handlers.parse_and_chunk_lambda.handler" ]
