# Simple single-stage for lightweight Lambda
FROM public.ecr.aws/lambda/python:3.11

# Copy and install dependencies
COPY requirements.txt ${LAMBDA_TASK_ROOT}/requirements.txt
COPY requirements-create-collection.txt ${LAMBDA_TASK_ROOT}/requirements-create-collection.txt
RUN pip install --only-binary=:all: --no-cache-dir -r requirements-create-collection.txt

# Copy application code
COPY handlers ${LAMBDA_TASK_ROOT}/handlers
COPY models ${LAMBDA_TASK_ROOT}/models

# Set the handler
CMD [ "handlers.create_collection_lambda.handler" ]
