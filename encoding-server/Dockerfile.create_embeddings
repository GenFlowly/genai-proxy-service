# Build stage
FROM public.ecr.aws/lambda/python:3.11 AS builder

# Install build dependencies
RUN yum install -y gcc gcc-c++ make cmake

# Copy and install dependencies
COPY requirements.txt /tmp/
COPY requirements-create-embeddings.txt /tmp/
RUN pip install --only-binary=:all: --no-cache-dir -r /tmp/requirements-create-embeddings.txt --target /tmp/python

# Runtime stage
FROM public.ecr.aws/lambda/python:3.11

# Copy installed dependencies to Lambda task directory
COPY --from=builder /tmp/python ${LAMBDA_TASK_ROOT}

# Copy application code
COPY handlers/create_embeddings_lambda.py ${LAMBDA_TASK_ROOT}/handlers/create_embeddings_lambda.py

# Set the handler
CMD [ "handlers.create_embeddings_lambda.handler" ]
