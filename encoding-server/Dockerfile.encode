# Build stage - install dependencies with build tools
FROM public.ecr.aws/lambda/python:3.11 AS builder

# Install build dependencies
RUN yum install -y gcc gcc-c++ make cmake

# Copy requirements
# Copy requirements
COPY requirements-encode.txt /tmp/requirements.txt

# Install dependencies with CPU-only PyTorch
# We use --extra-index-url to find cpu versions of torch while still allowing other packages from pypi
RUN pip install --no-cache-dir \
    --target /tmp/python \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    torch \
    -r /tmp/requirements.txt

# Set PYTHONPATH so we can use the installed packages
ENV PYTHONPATH=/tmp/python

# Remove unnecessary files to save space
RUN find /tmp/python -type d -name "tests" -exec rm -rf {} + && \
    find /tmp/python -type d -name "__pycache__" -exec rm -rf {} + && \
    rm -rf /tmp/python/pip /tmp/python/setuptools /tmp/python/wheel

# Runtime stage - copy compiled dependencies
FROM public.ecr.aws/lambda/python:3.11

# Set environment variables for Lambda
ENV TRANSFORMERS_CACHE=/tmp/transformers_cache \
    HF_HOME=/tmp/huggingface \
    MPLCONFIGDIR=/tmp/matplotlib \
    NUMBA_CACHE_DIR=/tmp/numba_cache \
    JOBLIB_TEMP_FOLDER=/tmp/joblib_tmp \
    JOBLIB_MULTIPROCESSING=0 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1

# Copy installed dependencies from builder
COPY --from=builder /tmp/python ${LAMBDA_TASK_ROOT}

# Copy application code
COPY email_model.py ${LAMBDA_TASK_ROOT}/
COPY models ${LAMBDA_TASK_ROOT}/models
COPY handlers ${LAMBDA_TASK_ROOT}/handlers

# Set the handler
CMD [ "handlers.encode_lambda.handler" ]
