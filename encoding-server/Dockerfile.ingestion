# Use base builder
FROM public.ecr.aws/lambda/python:3.12 AS builder

# Install from the exact-pin lock (scripts/compile-python-locks.sh)
COPY requirements.lock.txt /tmp/
RUN pip install --only-binary=:all: --no-cache-dir -r /tmp/requirements.lock.txt --target /tmp/python

# Runtime stage
FROM public.ecr.aws/lambda/python:3.12

# Copy installed dependencies to Lambda task directory
# LAMBDA_TASK_ROOT=/var/task (provided by AWS base image)
COPY --from=builder /tmp/python ${LAMBDA_TASK_ROOT}

# Copy application code
COPY handlers ${LAMBDA_TASK_ROOT}/handlers
COPY services ${LAMBDA_TASK_ROOT}/services

# Default handler only — the CDK stack overrides cmd per function
# (handlers.ingest_email_lambda.handler / handlers.ingest_notes_lambda.handler)
CMD [ "handlers.ingest_notes_lambda.handler" ]
