<configuration>
    <!-- Structured JSON lines (one object per line), field names aligned with
         the Python services' JSON logs (encoding_library.observability):
         timestamp / level / logger / message / service, plus MDC fields
         (request_id from the CallId plugin). -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <logger>logger</logger>
                <thread>[ignore]</thread>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
            <customFields>{"service":"genai-proxy-server"}</customFields>
        </encoder>
    </appender>
    <!-- Level from the environment: production sets LOG_LEVEL=WARN
         (fly.production.toml) so only problems are logged; development
         defaults to the full INFO narrative. The pinned loggers below must
         follow the same variable or they would keep emitting INFO in
         production. -->
    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="org.eclipse.jetty" level="${LOG_LEVEL:-INFO}"/>
    <logger name="io.netty" level="${LOG_LEVEL:-INFO}"/>
    <logger name="com.genflowly.aicallerlib" level="${LOG_LEVEL:-INFO}"/>
</configuration>
