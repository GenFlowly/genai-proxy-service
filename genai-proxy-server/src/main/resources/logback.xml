<configuration>
    <!-- Structured JSON lines (one object per line), field names aligned with
         the Python services' JSON logs (encoding_library.observability):
         timestamp / level / logger / message / service, plus MDC fields
         (request_id from the CallId plugin). -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <logger>logger</logger>
                <thread>[ignore]</thread>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
            <customFields>{"service":"genai-proxy-server"}</customFields>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="org.eclipse.jetty" level="INFO"/>
    <logger name="io.netty" level="INFO"/>
    <logger name="com.genflowly.aicallerlib" level="INFO"/>
</configuration>
