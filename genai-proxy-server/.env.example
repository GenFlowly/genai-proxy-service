# Local dev secrets for docker-compose. Copy to .env and fill in real values.
# .env is gitignored — never commit real keys.

AWS_ACCESS_KEY_ID=your-local-key
AWS_SECRET_ACCESS_KEY=your-local-secret

# Hugging Face token (embedding model downloads)
HF_TOKEN=

# Google OAuth credentials — obtain from Google Cloud Console.
# Required only for Gmail / Google Calendar tool nodes; leave blank to disable.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ENCODING_SERVER_URL=https://api-encode-development.genflowly.com

# Per-app account resolution: azp (Auth0 app clientId) -> app mapping
AUTH0_REACT_APP_CLIENT_IDS=
AUTH0_ADMIN_PANEL_CLIENT_IDS=

# Tavily key for the retrieval-server WEB_SEARCH graph node
TAVILY_API_KEY=

# Voyage key for retrieval-server query embedding (collections use voyage-4-large).
# Without it the RETRIEVAL node fails and answers lose knowledge-base context.
VOYAGE_API_KEY=

# System (default) Zilliz vector DB — used when a customer has no vector DB config in DynamoDB
ZILLIZ_ENDPOINT=
ZILLIZ_TOKEN=
