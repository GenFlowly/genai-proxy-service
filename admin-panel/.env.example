# Copy to .env.local and fill in. Same Auth0 tenant/API as genai-react-app,
# but a SEPARATE Auth0 application — do not reuse the react-app clientId
# (the backend maps the token's azp/clientId to the per-app account; see README).
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=admin-panel-spa-client-id
VITE_AUTH0_AUDIENCE=your-api-audience
VITE_BACKEND_URL=http://localhost:8080
