# Copy to .env.local and fill in.

# Base URL of the running genai-proxy-server
GENFLOWLY_PROXY_URL=http://127.0.0.1:8080

# Developer API key, created in the web app under Settings -> Developer.
# Stays server-side: the Next.js server attaches it to requests; it is never
# sent to the browser.
GENFLOWLY_API_KEY=gfy_...
