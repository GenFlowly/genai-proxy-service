# Copy to .env.local and fill in.

# Base URL of the running genai-proxy-server
GENFLOWLY_PROXY_URL=http://127.0.0.1:8080

# Developer API key, created in the web app under Settings -> Developer.
# Stays server-side: the Vite dev server attaches it to proxied /api requests;
# it is never sent to the browser (no VITE_ prefix = not bundled).
GENFLOWLY_API_KEY=gfy_...

# Dev server port
PORT=3006

# Set to 1 to watch the Playwright Chromium window (headed). Default: headless.
# PLAYWRIGHT_HEADED=1
